summary: Validate complytime-providers RPM sub-packages deliver provider binaries

discover:
    how: shell

execute:
    script:
      # Verify binaries are installed and executable
      - test -x /usr/libexec/complytime/providers/complyctl-provider-openscap
      - test -x /usr/libexec/complytime/providers/complyctl-provider-ampel
      - test -x /usr/libexec/complytime/providers/complyctl-provider-opa
      # Verify binaries are valid ELF executables
      - file /usr/libexec/complytime/providers/complyctl-provider-openscap | grep -q ELF
      - file /usr/libexec/complytime/providers/complyctl-provider-ampel | grep -q ELF
      - file /usr/libexec/complytime/providers/complyctl-provider-opa | grep -q ELF
